{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": false,
    "sourceMap": true,
    "outDir": "out",
    "noEmit": false
  },
  "include": ["src/**/*.ts", "actions/*/src/**/*.ts", "tests/**/*.ts", "scripts/**/*.mjs"],
  "exclude": ["node_modules", "**/dist", "out"]
}

    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.2",
    "esbuild": "^0.23.0",
    "typescript": "^5.5.2",
    "vitest": "^2.0.0"
  },
  "overrides": {
    "undici": "^8.10.1"
  }

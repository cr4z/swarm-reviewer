{
  "name": "swarm-reviewer",
  "private": true,
  "version": "1.0.0",
  "description": "Reusable GitHub Actions workflow for multi-model PR review.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "actionlint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {

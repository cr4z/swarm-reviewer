{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cr4z/swarm-reviewer/contracts/config.schema.json",
  "title": "Swarm Reviewer Configuration",
  "type": "object",
  "required": ["version", "agents"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "enum": [1],
      "description": "Config schema version. Run fails fast if not a supported value."
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/reviewAgent" },
      "description": "Exactly one entry must have role \"aggregator\"."
    },
    "diff": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxBytes": { "type": "integer", "minimum": 1024 }
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prComment": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true }
          }
        },
        "email": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": { "type": "boolean", "default": true },
            "recipients": {
              "type": "array",
              "items": { "type": "string", "format": "email" },
              "minItems": 1
            },
            "provider": { "type": "string", "enum": ["resend", "sendgrid"] },
            "apiKeySecret": { "type": "string", "minLength": 1 }
          },
          "allOf": [
            {
              "if": { "properties": { "enabled": { "const": true } }, "required": ["enabled"] },
              "then": { "required": ["recipients", "provider", "apiKeySecret"] }
            }
          ]
        }
      }
    }
  },
  "$defs": {
    "reviewAgent": {
      "type": "object",
      "required": ["id", "provider", "model", "apiKeySecret"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9_-]+$",
          "description": "Unique within agents[]. Used as the artifact key and in report/log output."
        },
        "provider": {
          "type": "string",
          "description": "Adapter key. Must match a registered provider adapter (see provider-adapter-contract.md)."
        },
        "model": {
          "type": "string",
          "description": "Provider-specific model identifier, passed through opaquely."
        },
        "apiKeySecret": {
          "type": "string",
          "minLength": 1,
          "description": "Name of the GitHub Actions secret holding this agent's credential."
        },
        "role": {
          "type": "string",
          "enum": ["reviewer", "aggregator"],
          "default": "reviewer"
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 180
        }
      }
    }
  }
}

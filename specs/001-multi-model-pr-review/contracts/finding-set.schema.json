{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/cr4z/swarm-reviewer/contracts/finding-set.schema.json",
  "title": "Finding Set",
  "description": "Artifact produced by one review agent (finding-<agentId>.json) and consumed by the aggregator.",
  "type": "object",
  "required": ["agentId", "model", "findings", "summary"],
  "additionalProperties": false,
  "properties": {
    "agentId": { "type": "string" },
    "model": { "type": "string" },
    "summary": { "type": "string" },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["severity", "description"],
        "additionalProperties": false,
        "properties": {
          "severity": { "type": "string", "enum": ["blocking", "warning", "note"] },
          "file": { "type": ["string", "null"] },
          "line": { "type": ["integer", "null"] },
          "description": { "type": "string" }
        }
      }
    }
  }
}

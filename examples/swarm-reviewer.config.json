    }
  ],
  "delivery": {
    "prComment": { "enabled": true },
    "email": {
      "enabled": true,
      "recipients": ["you@example.com"],
      "provider": "resend",
      "apiKeySecret": "EMAIL_API_KEY"
    }
  }
}

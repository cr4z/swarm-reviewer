{
  "version": 1,
  "agents": [
    {
      "id": "reviewer",
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "apiKeySecret": "ANTHROPIC_API_KEY"
    },
    {
      "id": "core",
      "provider": "anthropic",
      "model": "claude-sonnet-4-5",
      "apiKeySecret": "ANTHROPIC_AGGREGATOR_API_KEY",
